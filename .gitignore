### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml

### ARGUS ###
# 비밀정보 — 절대 커밋 금지
.env
.env.local
*.pem
*.key
secrets/

# 대용량 데이터 (5.2GB)
data/dart-disclosures/

# 논문 PDF (28MB)
paper/**/*.pdf

# 작업 산출물
scratch/
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
venv/
data/
paper/
# docs/ 는 추적한다 — 계획서·CONVENTION 이 산출물이다

# 인덱스 산출물 (로컬 생성, 배포 시 별도 전송)
artifacts/

# 결과 공개 사이트 — 생성물이다 (`python scripts/build_site.py` 로 언제든 다시 만든다).
# 🔴 빌더(`scripts/build_site.py`)와 테스트(`tests/test_site.py`)만 추적한다 —
# 생성물을 커밋하면 정본이 움직일 때마다 사본이 하나 더 낡는다(`artifacts/` 와 같은 규율).
site/

# SDD 작업공간 (플랜별 원장·브리프·리뷰패키지)
.superpowers/
