### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml

### ARGUS ###
# 비밀정보 — 절대 커밋 금지
.env
.env.local
*.pem
*.key
secrets/

# 대용량 데이터 (5.2GB)
data/dart-disclosures/

# 논문 PDF (28MB)
paper/**/*.pdf

# 작업 산출물
scratch/
.ipynb_checkpoints/
__pycache__/
*.pyc
.venv/
venv/
data/
paper/
# docs/ 는 추적한다 — 계획서·CONVENTION 이 산출물이다

# 인덱스 산출물 (로컬 생성, 배포 시 별도 전송)
artifacts/

# 서비스 사이트 v2 — 🔴 **소스는 추적하고 생성물만 뺀다.**
#   추적한다  site/app · site/components · package.json · tsconfig.json · next.config.ts
#   뺀다      아래 넷. 전부 명령 하나로 다시 만들어진다.
#
# 🔴 `site/public/data/` 는 `python scripts/build_service_data.py` 의 산출물이다.
#    커밋하면 `artifacts/` 가 움직일 때마다 사본이 하나 더 낡는다 — 그 결함을 열일곱 번 겪었다.
# 🔴 `site/node_modules/` 는 절대 커밋하지 않는다 — 제출물 1번(소스코드)에 섞이면 안 된다.
site/node_modules/
site/.next/
site/out/
site/public/data/

# SDD 작업공간 (플랜별 원장·브리프·리뷰패키지)
.superpowers/
