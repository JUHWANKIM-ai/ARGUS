                <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;" parent="1" source="d6" target="d7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="bE" value="남은 흠 — 셋 · 전부 일정과 무관하다" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#333333;dashed=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1320" y="890" width="400" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="z1" value="&lt;b&gt;✕ 코퍼스 밖 출처 안내&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;거절 뒤 네이버·DART 를 안내한다. 프롬프트로 두 번 겨냥해 두 번 기각 — A27 은 1건을 3건으로 늘렸다. &lt;b&gt;방법을 못 찾았다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#F8CECC;strokeColor=#B3453F;" parent="1" vertex="1">
                    <mxGeometry x="1338" y="930" width="366" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="z2" value="&lt;b&gt;✕ Q-107 · Q-117 검색 실패&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;질문의 &lt;i&gt;두코바니&lt;/i&gt; 와 근거의 &lt;i&gt;Dukovany&lt;/i&gt; 가 안 이어진다. 잇는 길이 별칭 사전뿐 — &lt;b&gt;안 하기로 정했다&lt;/b&gt; (평가셋 과적합)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#F8CECC;strokeColor=#B3453F;" parent="1" vertex="1">
                    <mxGeometry x="1338" y="1002" width="366" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="z3" value="&lt;b&gt;✕ 산문 속 법인번호 과잉 마스킹&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;법인번호와 주민번호는 형식이 같고 체크섬으로도 안 갈린다(34종 중 6종이 통과). 예외를 넓히면 가짜 주민번호가 샌다 — &lt;b&gt;안 하기로 정했다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#F8CECC;strokeColor=#B3453F;" parent="1" vertex="1">
                    <mxGeometry x="1338" y="1074" width="366" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="z4" value="&lt;font style='font-size:10px'&gt;🔴 &lt;b&gt;미탐은 오탐보다 나쁘다&lt;/b&gt; — 안전 장치는 가리는 쪽으로 기울여 둔다.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=none;strokeColor=none;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1338" y="1156" width="366" height="30" as="geometry"/>
