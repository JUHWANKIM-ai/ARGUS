                    <mxGeometry x="320" y="524" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="b7" value="&lt;b&gt;○ 근거 성형&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;생성 직전에만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;" parent="1" vertex="1">
                    <mxGeometry x="320" y="582" width="250" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="b8" value="&lt;b&gt;○ 정정사유·주요내용 (A30)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;런타임 사본에만 · 색인 불변&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;" parent="1" vertex="1">
                    <mxGeometry x="320" y="628" width="250" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="b9" value="&lt;b&gt;○ 법인번호 행 조회 (v6 신설)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;tools.corp_number_line — 계열회사 표에서 한 줄만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="590" y="472" width="260" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="b11" value="&lt;b&gt;○ 열거 로스터 (v6 · A39)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;계약상대 파트너 전량을 근거 머리에&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="860" y="472" width="260" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="b10" value="🔴 &lt;b&gt;조각이 문제였지 근거 칸이 아니었다.&lt;/b&gt; 목차를 &lt;i&gt;XII. 상세표 &amp;gt; 2. 계열회사 현황(상세)&lt;/i&gt; 로 좁히면 검색은 &lt;b&gt;맞는 보고서&lt;/b&gt;를 고른다. 그런데 그 섹션이 34,122자라 6조각으로 쪼개지고 BM25 가 회사명이 빽빽한 4번 조각을 고른다 — 정작 찾는 행은 &lt;b&gt;703자 지점(1번 조각)&lt;/b&gt;에 있다.&lt;br&gt;&lt;br&gt;칸을 늘리는 것은 v4 가 세 번 기각한 방향이고(A16·A17·depth) 6조각을 다 실으면 34K 자가 근거를 통째로 먹는다. 그래서 &lt;b&gt;섹션 전문에서 행 하나만&lt;/b&gt; 뽑아 머리에 둔다 — 집계 한 줄과 같은 자리다.&lt;br&gt;&lt;br&gt;🔴 &lt;code&gt;aggregate&lt;/code&gt; 가 아니라 &lt;code&gt;tools&lt;/code&gt; 에 뒀다. 그 모듈에 파일 접근이 없다는 것이 규약 &lt;b&gt;G2&lt;/b&gt; 판정의 근거다." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="590" y="540" width="690" height="148" as="geometry"/>
                </mxCell>
                <mxCell id="bC" value="B′.  결정적 집계        LLM 0회" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#333333;dashed=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="708" width="1260" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="&lt;b&gt;○ 집계 한 줄 (A29a)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;합 · 차 · 몫을 근거 머리에&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="748" width="270" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="&lt;b&gt;○ 정정 시계열 (A29b)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;체인 금액을 접수일 순으로&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;" parent="1" vertex="1">
                    <mxGeometry x="350" y="748" width="270" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="&lt;b&gt;✕ 계약상대 분포 (A29c)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;기각 — Δ 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#F8CECC;strokeColor=#B3453F;" parent="1" vertex="1">
                    <mxGeometry x="640" y="748" width="250" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="🔴 &lt;b&gt;칸이 아니라 줄이다.&lt;/b&gt; v4 는 같은 문항들을 &lt;i&gt;근거를 더 주는&lt;/i&gt; 방향으로 세 번 겨냥해 세 번 다 기각했다. 공통 사유가 &lt;i&gt;“칸을 더 달라”&lt;/i&gt; 였다. 여기서 실리는 것은 블록이 아니라 &lt;b&gt;한 줄&lt;/b&gt;이라 그 사유에 안 걸린다.&lt;br&gt;🔴 &lt;b&gt;자리가 값보다 셌다.&lt;/b&gt; Q-023 에 정정 금액 7건을 근거 &lt;b&gt;꼬리&lt;/b&gt;에 실었을 때 답은 여전히 &lt;i&gt;“변동 없이 유지”&lt;/i&gt; 였다. &lt;b&gt;같은 줄을 머리로 옮기자 뒤집혔다.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="60" y="810" width="1220" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="bD" value="C.  생성 · 검증 · 처분" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#333333;dashed=1;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="40" y="890" width="1260" height="500" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&lt;b&gt;● 답변 생성 ①&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HCX-005 · 온도 0.0 · 난이도 상이면 CoT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#FFE6CC;strokeColor=#C87A2F;" parent="1" vertex="1">
                    <mxGeometry x="60" y="930" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b&gt;◆ 근거 표기가 있는가 (v6 교정)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;🔴 “접수번호” 낱말 요구를 뗐다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#FFF2CC;strokeColor=#C9A227;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="60" y="992" width="250" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&lt;b&gt;● critic ②&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;judge — 표기가 없을 때만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#FFE6CC;strokeColor=#C87A2F;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1054" width="250" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="d4" value="&lt;b&gt;◇ 결정적 검증 4종&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;재계산 · 답변 내부 산술 · 수치 출처 · 완전성&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1110" width="250" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d5" value="&lt;b&gt;◇ 발주처 면제 (A36)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;발주처는 공시자가 아니다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1192" width="250" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="d6" value="&lt;b&gt;◇ 출력 안전 계층 (v6 교정)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;🔴 법인 라벨이면 번호를 남긴다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1244" width="250" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="d7" value="&lt;b&gt;○ 응답 — 5키 JSON&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;question_id · question · retrieved_context · think_trace · answer · 전부 string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#DAE8FC;strokeColor=#3A6FA8;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1320" width="600" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="d8" value="&lt;b&gt;처분 — 여덟 갈래&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=none;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="340" y="922" width="320" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="d9" value="&lt;b&gt;◇ ① 각주 (v6 교정)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;🔴 사유를 우리가 짓는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="340" y="944" width="320" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="d10" value="&lt;b&gt;◇ ② 치환 (A20)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;재계산값으로 바꾼다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="340" y="982" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d11" value="&lt;b&gt;● ③ 재생성 1회 (A20r)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;사유를 실어 다시 쓴다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#FFE6CC;strokeColor=#C87A2F;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1018" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d12" value="&lt;b&gt;◇ ④ 인용 부착 (A25)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;§7.5 형식을 우리가 짓는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1054" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d13" value="&lt;b&gt;◇ ⑤ 인용 떼기&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;거절이 단 표기를 지운다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1090" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d14" value="&lt;b&gt;◇ ⑥ 집계 치환 (A29s)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;근거의 amount 로 합계를&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1126" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d15" value="&lt;b&gt;◇ ⑦ 괄호 교정 (A35)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;억·조 환산을 다시 쓴다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1162" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d16" value="&lt;b&gt;◇ ⑧ 자기정합 (A38)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;식과 어긋나는 수를 맞춘다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1198" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="d18" value="&lt;b&gt;◇ ⑨ 반올림 복원 (v6 · A40)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;억만 적힌 금액을 근거의 원값으로&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1234" width="320" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="d19" value="&lt;b&gt;◇ ⑩ 결과값 부재 (v6 · A41)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;아는 값이 답에 없으면 결론을 우리가 적는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fontColor=#000000;fillColor=#D5E8D4;strokeColor=#4F8A55;strokeWidth=3;" parent="1" vertex="1">
                    <mxGeometry x="340" y="1272" width="320" height="34" as="geometry"/>
                </mxCell>
                <mxCell id="d17" value="🔴 &lt;b&gt;v5 의 단일 발견 — 값을 줘도 모델은 자기 계산을 더 믿는다.&lt;/b&gt; Q-034 에 정확한 817,900,000,000 을 싣고 &lt;i&gt;“다시 계산하지 말라”&lt;/i&gt; 는 지시까지 붙였는데 모델은 817,100,000,000 을 썼다. &lt;b&gt;그래도 헛일이 아니었다&lt;/b&gt; — 그 줄이 모델에게 &lt;b&gt;식을 쓰게 만들어&lt;/b&gt; equation 검사가 발화했고, 그래서 치환이 닿았다.&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;v6 는 그 원리를 우리 글에도 걸었다.&lt;/b&gt; 각주 사유를 critic 의 산문에서 가져오고 있었는데, critic 이 불리언과 산문을 따로 내서 &lt;b&gt;골든 17건 중 8건이 자기를 반박했다&lt;/b&gt;:&lt;br&gt;&lt;i&gt;(주의: 근거 검증을 통과하지 못했습니다 — 모든 수치가 근거에서 확인됩니다.)&lt;/i&gt;&lt;br&gt;&lt;i&gt;(주의: 근거 검증을 통과하지 못했습니다 — )&lt;/i&gt;&lt;br&gt;이제 사유를 &lt;b&gt;Verdict 의 불리언에서 짓는다&lt;/b&gt;. 값도 사유도 우리가 짓는다.&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;표기 검사가 규약이 아니라 우리 문안을 재고 있었다.&lt;/b&gt; 규약 R2 는 &lt;i&gt;공시명·공시일&lt;/i&gt; 을 요구하지 &lt;i&gt;접수번호&lt;/i&gt; 라는 낱말을 요구하지 않는다. 낱말 요구를 떼자 헛된 critic 호출이 &lt;b&gt;132회 → 106회&lt;/b&gt;로 줄었다 (−26,481토큰 · −186원/판). 정답률은 안 움직였다.&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;대가도 적는다.&lt;/b&gt; 집계 치환은 &lt;i&gt;틀린 합계&lt;/i&gt;를 &lt;i&gt;맞는 합계 + 안 맞는 풀이&lt;/i&gt;로 바꾼다. Q-113·Q-115 가 그 자리이고, 110/112 를 사는 대신 「추론 논리성」 2건을 냈다 &lt;b&gt;(알고 남긴 선택)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;「추론 논리성」 검사 다섯&lt;/b&gt; (수치 자기정합 · 식 불성립 · 근거 밖 수치 · 순서 오류 · 자기부정) — 실패 양식 &lt;b&gt;일곱 중 다섯&lt;/b&gt;. 🔴 전제 누락 · 비약은 &lt;b&gt;측정하지 않는다&lt;/b&gt;. 골든 &lt;b&gt;109/112&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="690" y="944" width="590" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;" parent="1" source="a1" target="a2" edge="1">
