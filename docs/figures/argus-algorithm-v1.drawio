                <mxCell id="n70" value="▸ 근거 인용 형식(주최 측 예시):  (근거: 사업보고서 2025.12, 접수번호 20260310002820, III-1 요약재무정보)&lt;br&gt;▸ closed 질의에 한해 Self-Consistency k=3 — open-ended 서술형에는 적용 불가 (논문 명시 한계)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#444444;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="95" y="962" width="1180" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="n71" value="C. 예산·안전 가드" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#B85450;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="1330" y="340" width="450" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="n72" value="&lt;b&gt;질문당 호출 상한&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot; color=&quot;#5A5A5A&quot;&gt;고정 횟수 파이프라인 — 대화형 멀티에이전트 금지&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;verticalAlign=middle;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="1355" y="386" width="400" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="n73" value="&lt;b&gt;총 스텝 ≤ 8 · hop ≤ 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot; color=&quot;#5A5A5A&quot;&gt;ReAct 실측: 7스텝 초과 궤적은 0.84%&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;verticalAlign=middle;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="1355" y="452" width="400" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="n74" value="&lt;b&gt;CoT는 난이도 상만&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot; color=&quot;#5A5A5A&quot;&gt;출력 토큰 30배 — 라우터가 걸러낸다&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;verticalAlign=middle;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="1355" y="518" width="400" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="n75" value="&lt;b&gt;이중 종료 장치&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot; color=&quot;#5A5A5A&quot;&gt;자연어 TERMINATE + 코드 상한&lt;br&gt;LLM은 calibration 안 됨 → 자기 종료 판단 불신&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;verticalAlign=middle;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="1355" y="584" width="400" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="n76" value="D. 평가 8지표 대응" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82B366;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="1330" y="700" width="450" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="n77" value="정확성            n-ary 레코드 · 결정적 계산 (⑥)&lt;br&gt;근거 완전성        PCST 연결 서브그래프 (⑤)&lt;br&gt;요구사항 충족      GoT 집계 · 복수 섹션 종합&lt;br&gt;근거 기반(환각)    critic 판정 (⑧) + provenance&lt;br&gt;추론 논리성        think_trace 로그 (⑨)&lt;br&gt;안전성·신뢰성      마스킹 · 인젝션 필터  ← 논문에 없음&lt;br&gt;정보한계 대응      unanswerable 경로 + 역질문  ← 논문에 없음&lt;br&gt;근거 표시          접수번호·섹션 경로 인용 강제" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="1355" y="742" width="400" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="n78" value="▸ 마지막 두 지표는 17편 어디에도 설계가 없다 — 직접 만들어야 할 차별화 지점" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#B85450;fontStyle=0;whiteSpace=wrap;" parent="1" vertex="1">
