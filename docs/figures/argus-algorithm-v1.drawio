                <mxCell id="n58" value="&lt;b&gt;⑤ 근거 압축 · distractor 제거&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px&quot; color=&quot;#5A5A5A&quot;&gt;PCST 연결 서브그래프&lt;br&gt;계약체결↔해지 · 원본↔정정&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;verticalAlign=middle;strokeWidth=1.5;" parent="1" vertex="1">
