                <mxCell id="v3e7" value="거래소 · 주요사항 · 지분" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2.2;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;" parent="1" source="v3b1" target="v3b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="v3e8" value="정기공시" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;strokeWidth=2.2;endArrow=block;endFill=1;endSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Times New Roman;fontColor=#000000;" parent="1" source="v3b1" target="v3b3" edge="1">
