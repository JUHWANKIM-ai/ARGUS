                <mxCell id="v3ca" value="A.  입력 · 라우팅        LLM 0회" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3A6FA8;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="236" width="1660" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="v3a1" value="&lt;b&gt;질의 수신&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GET /answer&lt;br&gt;question_id · question&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=15;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="298" width="190" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3a2" value="&lt;b&gt;입력 안전 계층&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sanitize_question&lt;br&gt;PII 마스킹 · 프롬프트 인젝션 탐지&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B3453F;fontSize=15;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="286" y="298" width="210" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3a3" value="&lt;b&gt;라우터&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;route() — 규칙만으로 가른다&lt;br&gt;기업 식별 · 범위 판정 · 난이도 · 전략(CoT/SC) · 문서군&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ CoT 2022 · Self-Consistency 2023 (전략 판정)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=15;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="516" y="298" width="240" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3a4" value="&lt;b&gt;답할 수 있는 범위인가&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#C9A227;fontSize=14;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="786" y="286" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="v3a5" value="&lt;b&gt;범위 밖 — 한계 고지&lt;/b&gt;   &lt;font style=&quot;font-size:11px&quot;&gt;UNANSWERABLE · 70개사 · 2023.01~2026.03&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="272" width="300" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="v3a6" value="&lt;b&gt;지목한 보고서 부재&lt;/b&gt;   &lt;font style=&quot;font-size:11px&quot;&gt;NO_SUCH_REPORT · missing_named_report()&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="340" width="300" height="54" as="geometry"/>
                </mxCell>
                <mxCell id="v3a7" value="한계 고지가 &lt;b&gt;두 갈래&lt;/b&gt;다.  기업도 연도도 범위 안인데 &lt;b&gt;그 보고서만&lt;/b&gt; 없는 경우는 '범위 밖' 이라고 말하면 안 된다 — 사용자가 다시 물을 방법을 못 찾는다.&lt;br&gt;어느 사업연도 · 보고서 종류를 확인해 줄지 되묻는 것이 정확한 응대다. 판정은 manifest 조회이고 인덱스를 열지 않는다 (스텝 0)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1320" y="276" width="370" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="v3a8" value="라우터는 &lt;b&gt;LLM 을 한 번도 부르지 않는다&lt;/b&gt; — 규칙으로 갈린다. 그래서 답할 수 없는 질의는 &lt;b&gt;크레딧 0원&lt;/b&gt;으로 끝난다 (실측 발화 2건, 둘 다 answerable=false · 과잉 거절 0건).&lt;br&gt;라우터가 정하는 것 넷 :  질의 유형(closed_lookup · multi_compare · complex_reason · unanswerable) · 난이도 · CoT/SC 사용 여부 · 문서군(exchange · major · holding · periodic)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="404" width="1230" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="v3cb" value="B.  검색 · 도구        전 단계 LLM 0회" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3A6FA8;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="506" width="1660" height="440" as="geometry"/>
                </mxCell>
                <mxCell id="v3b1" value="&lt;b&gt;메타 프리필터&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;filter_docs / 검색 인자&lt;br&gt;corp_name · rcept_dt · group&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=15;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="572" width="200" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="v3b2" value="&lt;b&gt;BM25 hop 사다리&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;거래소 · 주요사항 · 지분공시&lt;br&gt;narrow → relax_period → corp_only → global&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ Relink 2026 · ToG-2 2025&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="306" y="548" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="v3b3" value="&lt;b&gt;섹션 인덱스 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;정기공시 — 목차 경로로 좁힌다&lt;br&gt;toc_narrow · toc_corp (사업연도 축)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ GraphReader 2024&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="306" y="648" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="v3b4" value="&lt;b&gt;근거가 충분한가&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;_sufficiency&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ ReAct 2023 · ToG-2 2025&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#C9A227;fontSize=14;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="596" y="560" width="210" height="118" as="geometry"/>
                </mxCell>
                <mxCell id="v3b5" value="판정 축 다섯, 전부 &lt;b&gt;LLM 0회&lt;/b&gt; :  후보 수 · BM25 최고점 ≥ 10.0 · 질문이 요구한 골든 필드 존재 · 비교 질의의 기업 커버리지 ·&lt;br&gt;&lt;b&gt;집합 완결성&lt;/b&gt;(근거가 가리키는 정정 · 후속 공시가 안 빠졌는가 = chain_open). 판정에 LLM 을 쓰면 hop 마다 호출이 붙어 6회 상한을 태운다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="306" y="742" width="510" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="v3b6" value="&lt;b&gt;이벤트 · 열거 hop&lt;/b&gt;   &lt;font style=&quot;font-size:11px&quot;&gt;hop 4&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;query_events 폴백 / strat=enumerate&lt;br&gt;계약상대별로 묶어 갈래를 낸다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ GraphReader 2024&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="846" y="548" width="260" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3b7" value="&lt;b&gt;정정체인 추적&lt;/b&gt;   &lt;font style=&quot;font-size:11px&quot;&gt;hop 5&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chain_probe (0스텝) + get_history (1스텝)&lt;br&gt;정정 체인 · 후속 공시 · 해지 대상 원계약&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ 자체 고안 — 논문 근거 없음&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="846" y="642" width="260" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3b8" value="&lt;b&gt;계약상대 그래프&lt;/b&gt;   &lt;font style=&quot;font-size:11px&quot;&gt;hop 6&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;query_by_counterparty — 발주처 2-hop&lt;br&gt;fan-in / fan-out · 근거 칸을 따로 쓴다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ HippoRAG 2024 · Relink 2026&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="846" y="736" width="260" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3b9" value="&lt;b&gt;계산 도구 7종&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;증감률 · 비중 · 합산 · 평균 · CAGR · 비교 · 기간&lt;br&gt;&lt;b&gt;&lt;b&gt;재고 기각&lt;/b&gt; — tools= 를 실제로 이어 쟀다&lt;br&gt;그리드 A24 59 · A24b 64 &amp;lt; 베이스라인 67&lt;br&gt;도구가 정답을 줘도 &lt;b&gt;옮겨 적다 틀리고&lt;/b&gt;&lt;br&gt;고치면 &lt;b&gt;도구 인자에서 틀린다&lt;/b&gt;&lt;br&gt;97,146,675 → 97,146,765&lt;br&gt;&lt;/b&gt; — 결정적 계산값은 &lt;b&gt;근거 블록에 미리 박혀&lt;/b&gt; 프롬프트에 닿는다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ Toolformer 2023 — 재고 기각&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1146" y="548" width="280" height="146" as="geometry"/>
                </mxCell>
                <mxCell id="v3b10" value="&lt;b&gt;근거 성형&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;shape_evidence — 생성 직전에만&lt;br&gt;schema_fields · calc_values&lt;br&gt;검색 · 충분성 판정은 원본을 본다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ G-Retriever 2024&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1146" y="706" width="280" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="v3b11" value="근거 칸 : 검색 10 + 발주처 6.&lt;br&gt;절단은 &lt;b&gt;체인을 먼저 살린다&lt;/b&gt; — 도착 순서로 자르면 정답인 마지막 정정본이 잘려 나간다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="560" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="v3b12" value="여기까지 &lt;b&gt;LLM 호출 0회 · 크레딧 0원&lt;/b&gt;이다.  도구는 전부 색인 · 레코드 조회이고, 예산은 스텝 8 · 재검색 hop 3 으로 코드가 못박는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="836" width="1300" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="v3b13" value="차선을 나눈다 :  검색 차선과 발주처 차선은 근거 칸 · 충분성 판정 · 체인 씨앗 · 스텝 순서를 공유하지 않는다. 네 축을 다 닫아야 '발주처 hop 유무와 무관하게 검색 차선이 같다' 가 성립한다.&lt;br&gt;넓히는 것이 늘 이득은 아니다 — 체인 씨앗은 상위 2건 · 대체본만(해지→원계약은 좁은 예외) · 끌어올 문서 6건까지. 코퍼스 기간(2023.01~2026.03) 밖 연도는 재검색하지 않는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="864" width="1610" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="v3cc" value="C.  생성 · 검증 · 처분" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="966" width="1660" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="v3c1" value="&lt;b&gt;근거가 있는가&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#C9A227;fontSize=14;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="1026" width="190" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="v3c2" value="&lt;b&gt;한계 고지&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LLM 호출 없이 내보낸다&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="1166" width="190" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="v3c3" value="&lt;b&gt;답변 생성  ①&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HCX-005 · 온도 0.0&lt;br&gt;난이도 상이면 CoT (max_tokens 800/300)&lt;br&gt;근거 인용 강제 — 보고서명 · 접수번호 14자리 · 섹션경로&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ GPT-3 2020 · CoT 2022&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#C87A2F;fontSize=15;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="306" y="1024" width="240" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="v3c4" value="&lt;b&gt;근거 표기가 있는가&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;quick_check&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#C9A227;fontSize=14;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="586" y="1026" width="200" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="v3c5" value="&lt;b&gt;critic  judge  ②&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;인용이 없을 때만 부른다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ SWE-Lancer 2025 · CAMEL 2023&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#C87A2F;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="586" y="1166" width="200" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="v3c6" value="&lt;b&gt;결정적 검증 3종&lt;/b&gt;   &lt;font style=&quot;font-size:11px&quot;&gt;LLM 0회&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;verify_calculation — 근거 원값으로 재계산 대조&lt;br&gt;verify_completeness — 근거가 충분한가&lt;br&gt;&lt;b&gt;verify_number_provenance (v4 신설)&lt;/b&gt; — 12자리 이상 수치가 근거에 완전일치로 있는가&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ 자체 고안 — SWE-Lancer 의 판단&amp;gt;생성 논거&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B3453F;fontSize=15;verticalAlign=middle;strokeWidth=4;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="826" y="1018" width="290" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="v3c7" value="&lt;b&gt;검사가 발화했나&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#C9A227;fontSize=14;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1156" y="1026" width="190" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="v3c8" value="&lt;b&gt;재생성 1회  ③   (A20r · v4 신설)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;실패 사유를 프롬프트에 실어 다시 쓴다&lt;br&gt;온도 0.0 그대로 — 사유 주입이 이 단계의 전부다&lt;br&gt;재생성은 &lt;b&gt;1회&lt;/b&gt;로 못박는다 · 재생성본에도 검사가 발화하면 &lt;b&gt;원본을 쓴다&lt;/b&gt;&lt;br&gt;&lt;b&gt;🔴 운영 기본값이다 (ablation._current = A20R)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ 자체 고안 (v4 신설)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#C87A2F;fontSize=15;verticalAlign=middle;strokeWidth=4;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1386" y="1010" width="300" height="136" as="geometry"/>
                </mxCell>
                <mxCell id="v3c9" value="&lt;b&gt;출력 안전 계층&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;mask_pii — 주민번호 · 전화 · 이메일 · 계좌&lt;br&gt;금액 · 접수번호는 건드리지 않는다&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B3453F;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="826" y="1170" width="290" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="v3c10" value="&lt;b&gt;응답 —  5키 JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;question_id · question · retrieved_context · think_trace · answer&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;fontSize=15;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1156" y="1170" width="530" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="v3c11" value="&lt;b&gt;LLM 호출은 여기서만 일어난다&lt;/b&gt; — ① 생성 1회, ② 인용이 누락됐을 때만 critic 1회, ③ 검사가 발화했을 때만 재생성 1회. 상한은 6회이고 실사용은 think_trace 의 budget llm= 에 남는다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="1258" width="1610" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="v3c12" value="v3 까지의 처분은 &lt;b&gt;각주뿐&lt;/b&gt;이었다 (탐지 100% · 교정 0%) — 정답을 계산해 놓고 버렸다. v4 는 처분을 둘로 갈라 나란히 쟀다 :  A20 = 재계산값 치환 · &lt;b&gt;A20r = 사유를 실어 재생성&lt;/b&gt;.&lt;br&gt;온도 0.0 에서 같은 프롬프트로 다시 부르면 같은 답이 나오므로 &lt;b&gt;사유 주입이 조작의 전부&lt;/b&gt;다. 다양성을 사는 조작(A10 · SC k=3 · 온도 0.7)은 축이 다른 별개 arm 이고 통제 변수를 깨므로 단독으로 잰다." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="1286" width="1610" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="v3cd" value="D.  가드 · 예외 · 계기판" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7A7A7A;strokeWidth=2.5;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontSize=17;fontStyle=1;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1366" width="1660" height="152" as="geometry"/>
                </mxCell>
                <mxCell id="v3d1" value="&lt;b&gt;예산 가드&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;스텝 8 · 재검색 hop 3 · LLM 6회 · 20,000 토큰&lt;br&gt;상한을 넘겨도 예외를 밖으로 던지지 않는다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ AutoGen 2023 · GraphRAG-R1 2026&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="76" y="1420" width="300" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3d2" value="&lt;b&gt;fault_response  (v4 신설)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;어떤 예외에도 200 + 5키 · stage=api 표식&lt;br&gt;재시도 2회 정책 대비 — 500 은 0점 + 크레딧 3배&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B3453F;fontSize=14;verticalAlign=middle;strokeWidth=4;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="400" y="1420" width="320" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3d3" value="&lt;b&gt;안전성 축  (v4 신설)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PII 유출 · 정책적 거절 · 인식론적 거절&lt;br&gt;세 축을 갈라 센다 — 정당한 거절을 환각으로 세지 않는다&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B3453F;fontSize=14;verticalAlign=middle;strokeWidth=4;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="744" y="1420" width="320" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3d4" value="&lt;b&gt;think_trace 계기판&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;hop 로그 · verdict · verify · budget&lt;br&gt;upstream_error — 상류 장애를 거절과 구분한다&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1088" y="1420" width="290" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="v3d5" value="&lt;b&gt;arm 스위치&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ablation — 분기점을 한 곳의 플래그로 모은다&lt;br&gt;운영 기본값 = 제출 구성 = A20r&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3A6FA8;fontSize=14;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1402" y="1420" width="284" height="76" as="geometry"/>
                </mxCell>
        <mxCell id="v3p0" value="&lt;b&gt;근거 논문 17편&lt;/b&gt; — 도면 안의 &lt;font color=&quot;#8a5a00&quot;&gt;◇&lt;/font&gt; 가 그 단계의 근거다. 전문은 &lt;i&gt;docs/pipeline/09-ablation.md&lt;/i&gt; 부록 A·B·C&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;채택 14&lt;/b&gt; : GPT-3 2020 · CoT 2022 · ReAct 2023 · Self-Consistency 2023 · Toolformer 2023 · CAMEL 2023 · AutoGen 2023 · G-Retriever 2024 · GraphReader 2024 · HippoRAG 2024 · ToG-2 2025 · SWE-Lancer 2025 · Relink 2026 · GraphRAG-R1 2026&lt;br&gt;&lt;b&gt;측정 후 기각 3&lt;/b&gt; : &lt;b&gt;HyperGraphRAG 2025&lt;/b&gt; — n-ary 하이퍼엣지. &lt;b&gt;고차 관계는 규칙이 이미 먹었다&lt;/b&gt; — 규칙이 잡은 1,829건은 84.2% 가 arity ≥ 3 인 반면, 남은 238건은 &lt;b&gt;58.4% 가 arity ≤ 2&lt;/b&gt; 라 논문 자신의 전제(&quot;arity ≤ 2 면 이득 0&quot;)에 걸린다 · &lt;b&gt;Graph of Thoughts 2024&lt;/b&gt; — 집계 미구현 · &lt;b&gt;GraphRAG 2024&lt;/b&gt; — 커뮤니티 요약. 규모 미달&lt;br&gt;&lt;b&gt;부분 기각&lt;/b&gt; : Toolformer 의 &lt;b&gt;자율 도구 호출&lt;/b&gt; 은 재고 기각 — 그리드 A24 59 · A24b 64 &amp;lt; 베이스라인 67 · G-Retriever 의 &lt;b&gt;PCST 압축&lt;/b&gt; 은 후보 풀 p50 = 2 라 압축할 것이 없다 · Self-Consistency 의 &lt;b&gt;다수결(A10)&lt;/b&gt; 은 표본마다 다른 자리에서 틀려 성립하지 않는다&lt;br&gt;&lt;b&gt;논문 근거 없이 우리가 고안한 것&lt;/b&gt; : 정정체인 추적 · 결정적 검증 3종 · 재생성 1회 · 입출력 안전 계층 · 안전성 축 · 메타 프리필터&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1528" width="1660" height="110" as="geometry" />
        </mxCell>
                <mxCell id="v3f1" value="v2 도면 대비 바뀐 것 :  ① 논문 매핑을 &lt;b&gt;나열&lt;/b&gt; 하던 것을 &lt;b&gt;실행 순서&lt;/b&gt; 도면으로 바꾸고, 근거는 각 단계에 &lt;font color=&quot;#8a5a00&quot;&gt;◇&lt;/font&gt; 표시로 붙였다 ② 색 규약을 '비용' 에서 &lt;b&gt;'LLM 호출 여부'&lt;/b&gt; 로 ③ 미구현 요소(PPR · PCST · GoT · SC 상시) 제거 ④ v4 신설 셋(수치 출처 검증 · 재생성 1회 · fault_response) 추가 ⑤ 입출력 안전 계층과 두 갈래 한계 고지를 명시." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1650" width="1660" height="24" as="geometry"/>
                </mxCell>
