                <mxCell id="v3lg6" value="파랑이 파이프라인의 대부분이다 — 검색 · 도구 · 검증이 전부 LLM 0회다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;whiteSpace=wrap;fontFamily=Times New Roman;fontColor=#000000;" parent="1" vertex="1">
