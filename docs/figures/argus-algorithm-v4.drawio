        <mxCell id="lg1" value="&lt;b&gt;LLM 0회&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;규칙 · 색인 · 레코드 조회 · 검증&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
