          <mxGeometry x="1518" y="104" width="176" height="40" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="&lt;font style=&quot;font-size:10px&quot;&gt;굵은 테두리 = &lt;b&gt;v4 규약 감사(08-16) 이후 새로 생기거나 고친 단계&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1328" y="152" width="366" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg6" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;파랑이 파이프라인의 대부분이다&lt;/b&gt; — 검색·검증·인용이 전부 LLM 0회다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1328" y="170" width="366" height="16" as="geometry" />
        </mxCell>
        <mxCell id="ca" value="A. 입력 · 라우팅 &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;LLM 0회&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="216" width="1660" height="268" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;질의 수신&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GET /answer&lt;br&gt;question_id · question&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="74" y="274" width="176" height="66" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;입력 안전 계층&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;sanitize_question&lt;br&gt;PII 마스킹 · 인젝션 탐지&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;v4: 조사가 붙어도 가린다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="270" y="268" width="208" height="78" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;라우터&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;route() — 규칙만으로 가른다&lt;br&gt;기업 식별 · 범위 · 난이도 · 문서군&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ CoT 2022&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="498" y="268" width="226" height="78" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;답할 수 있는가&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="744" y="262" width="168" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;범위 밖&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;UNANSWERABLE · 70개사 · 2023.01~2026.03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="936" y="236" width="288" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;지목한 보고서 부재&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NO_SUCH_REPORT — 어느 보고서인지 되묻는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="936" y="290" width="288" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;지시대상 불명&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(v4 신설)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AMBIGUOUS_REFERENCE — 어느 기업인지 되묻는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="936" y="344" width="288" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="&lt;b&gt;한계 고지가 세 갈래다.&lt;/b&gt; 한계의 종류가 다르면 고지도 달라야 한다 — 감사 &lt;i&gt;AUD-15&lt;/i&gt; 에서 &lt;i&gt;“그 회사의 작년 실적”&lt;/i&gt; 을 &lt;b&gt;‘범위 밖’ 이라 답했다.&lt;/b&gt; 기업이 지목되지 않은 것인데 그렇게 말하면 사용자는 자기가 물은 회사가 70개사에 없다고 오해한다. &lt;b&gt;CONVENTION §3 R4&lt;/b&gt; 가 요구하는 역질문이 이 자리다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1244" y="236" width="442" height="154" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;라우터는 LLM 을 한 번도 부르지 않는다&lt;/b&gt; — 답할 수 없는 질의는 &lt;b&gt;크레딧 0원&lt;/b&gt; 으로 끝난다 (실측 &lt;i&gt;llm=0 tokens=0&lt;/i&gt;). 🔴 그리고 &lt;b&gt;쿼리가 빠져도 200 + 5키&lt;/b&gt; 를 낸다 — &lt;i&gt;question&lt;/i&gt; 만 온 요청은 답할 수 있는데 422 로 버리면 스스로 0점을 만든다 (감사 &lt;i&gt;F-4&lt;/i&gt;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="74" y="400" width="1150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cb" value="B. 검색 · 근거 &amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:10px&quot;&gt;LLM 0회&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="504" width="1660" height="396" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="&lt;b&gt;메타 프리필터&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;filter_docs&lt;br&gt;corp_name · rcept_dt · group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="74" y="566" width="186" height="66" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="&lt;b&gt;BM25 hop 사다리&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;narrow → relax_period → corp_only → global&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ Relink 2026 · ToG-2 2025&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="280" y="552" width="224" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="&lt;b&gt;섹션 인덱스 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;정기공시 — 목차 경로로 좁힌다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ GraphReader 2024&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="280" y="646" width="224" height="68" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;근거가 충분한가&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;_sufficiency&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="524" y="556" width="186" height="96" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;font style=&quot;font-size:10px&quot;&gt;판정 축 다섯, 전부 LLM 0회 : 후보 수 · BM25 최고점 · 골든 필드 · 비교 질의 커버리지 · 정정 체인 완결성&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;🔴 &lt;b&gt;미해결(F-8)&lt;/b&gt; — hop 0 에서 89점짜리 정답 근거를 이미 찾고도 &lt;i&gt;few:1&amp;lt;2&lt;/i&gt; 로 두 번 더 검색해 무관한 근거를 끌어들인다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="280" y="728" width="430" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;이벤트 · 열거 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;query_events · 계약상대별로 갈래를 낸다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ GraphReader 2024&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="730" y="552" width="234" height="68" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="&lt;b&gt;정정체인 추적 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;chain_probe + get_history&lt;br&gt;정정 체인 · 후속 · 해지 원계약&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ 자체 고안&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="730" y="632" width="234" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="&lt;b&gt;계약상대 그래프 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;발주처 2-hop fan-in / fan-out&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ HippoRAG 2024 · Relink 2026&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="730" y="720" width="234" height="68" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="&lt;b&gt;근거 성형&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shape_evidence — 생성 직전에만&lt;br&gt;schema_fields · calc_values&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ G-Retriever 2024&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="986" y="552" width="216" height="74" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="&lt;b&gt;근거 기억&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(v4 신설)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;_citation_source — 근거로 삼은 레코드의&lt;br&gt;보고서명 · 기준연월 · 접수번호 · 섹션경로를&lt;br&gt;그대로 적어 둔다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="986" y="636" width="216" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="&lt;b&gt;계산 도구 7종&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;증감률 · 비중 · 합산 · 평균 · CAGR · 비교 · 기간&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;재고 기각&lt;/b&gt; — tools= 를 실제로 이어 쟀다&lt;br&gt;A24 59 · A24b 64 &amp;lt; 베이스라인 66&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ Toolformer 2023 — 재고 기각&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="986" y="726" width="216" height="88" as="geometry" />
        </mxCell>
        <mxCell id="b12" value="&lt;b&gt;왜 기억해 두는가&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;검색이 넘기는 청크는 &lt;i&gt;{doc_id, score}&lt;/i&gt; 뿐이라 인용을 지을 재료가 없다. 그래서 색인·레코드에서 정본을 조회해 적어 둔다 (LLM 0회).&lt;br&gt;&lt;br&gt;🔴 마크다운으로 렌더해 놓고 &lt;b&gt;정규식으로 도로 읽는 길&lt;/b&gt; 도 있었고 실제로 그렇게 먼저 짰다. 그것은 이 저장소가 반복해 데인 &lt;b&gt;‘같은 값을 두 곳에 적고 한쪽만 고친다’&lt;/b&gt; 와 같은 모양이라 바꿨다 — 정기공시 섹션경로가 특히 다르다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1222" y="552" width="464" height="164" as="geometry" />
        </mxCell>
        <mxCell id="b13" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;여기까지 LLM 호출 0회 · 크레딧 0원&lt;/b&gt; 이다. 근거 칸은 검색 10 + 발주처 6이고, 절단은 정정 체인을 먼저 살린다 — 도착 순서로 자르면 정답인 마지막 정정본이 잘려 나간다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="1222" y="728" width="464" height="52" as="geometry" />
        </mxCell>
        <mxCell id="cc" value="C. 생성 · 검증 · 처분" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="920" width="1660" height="470" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;근거가 있는가&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="74" y="976" width="168" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;한계 고지&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LLM 호출 없이 내보낸다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="74" y="1092" width="168" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;답변 생성 ①&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HCX-005 · 온도 0.0 · 난이도 상이면 CoT&lt;br&gt;근거 인용 강제&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ GPT-3 2020 · CoT 2022&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="268" y="972" width="218" height="96" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;근거 표기가 있는가&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;quick_check&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="508" y="976" width="180" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;critic ②&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;judge — 인용이 없을 때만 부른다&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ SWE-Lancer 2025 · CAMEL 2023&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="508" y="1092" width="180" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;결정적 검증 4종&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;LLM 0회&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;verify_calculation — 근거 원값으로 재계산&lt;br&gt;verify_answer_arithmetic — 답변 내부 산술&lt;br&gt;verify_number_provenance — 수치가 근거에 있나&lt;br&gt;verify_completeness — 근거가 충분한가&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="710" y="964" width="252" height="108" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;검사가 발화했나&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="986" y="976" width="168" height="88" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;처분 — v4 는 다섯 갈래다&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fillColor=none;strokeColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1178" y="942" width="508" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;b&gt;③ 재생성 1회&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(A20r · 켜짐)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;실패 사유를 프롬프트에 실어 다시 쓴다 · 온도 0.0 그대로&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="1178" y="970" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;치환&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(A20 · 꺼짐)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;재계산값으로 답변의 수치를 바꾼다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="1436" y="970" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;④ 인용 부착&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(A25 · v4 신설)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;기억한 레코드로 §7.5 형식을 우리가 짓는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1040" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;⑤ 인용 떼기&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot;&gt;(v4 신설)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;거절이 스스로 단 근거 표기를 제거한다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1436" y="1040" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;각주만 달던 v3 의 처분&lt;/b&gt; — 탐지 100% · 교정 0%&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1178" y="1110" width="508" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;출력 안전 계층&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mask_pii — 주민번호 · 전화 · 이메일 · 계좌&lt;br&gt;금액 · 접수번호는 건드리지 않는다&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;v4: 조사·법인등록번호 결함 둘을 닫았다&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="710" y="1092" width="252" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;응답 — 5키 JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;question_id · question · retrieved_context · think_trace · answer · 전부 string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="986" y="1092" width="168" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="🔴 &lt;b&gt;v4 가 확정한 것 — 모델이 숫자를 손에 쥐는 순간 틀린다.&lt;/b&gt; 그래서 처분 넷 중 셋이 &lt;b&gt;LLM 0회&lt;/b&gt; 다. 재계산값도 접수번호도 우리가 근거에서 직접 읽어 쓴다.&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;치환(A20)은 지금 &lt;b&gt;꺼져 있다&lt;/b&gt; — v4 가 치환과 재생성을 나란히 재려고 갈라 둔 설계였고, &lt;b&gt;둘을 함께 켠 arm 은 아직 안 쟀다.&lt;/b&gt; 재생성은 LLM 호출이라 비결정적이고(실측 &lt;i&gt;AUD-11&lt;/i&gt;: 게이트는 잡았으나 재생성이 못 고쳤다) 치환은 결정적이므로, &lt;b&gt;재생성 실패 시의 안전망&lt;/b&gt; 으로 결합을 재는 것이 다음 후보다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="74" y="1190" width="1612" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;LLM 호출은 여기서만 일어난다&lt;/b&gt; — ① 생성 1회, ② 인용이 누락됐을 때만 critic 1회, ③ 검사가 발화했을 때만 재생성 1회. 실측 최대 3회 (상한 6회).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;" vertex="1" parent="1">
          <mxGeometry x="74" y="1276" width="1612" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;font style=&quot;font-size:10px&quot;&gt;🔴 &lt;b&gt;인용을 붙이는 기준은 ‘문구’ 가 아니라 ‘연결’ 이다&lt;/b&gt; — 접수번호 · 금액 · 제목 낱말 중 하나도 안 걸리면 그 답변이 이 근거를 썼다고 말할 수 없으므로 붙이지 않는다. 거절 어형 목록을 늘리는 길은 끝이 없다(모델의 표현은 열려 있다).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#F5F5F5;strokeColor=#B3B3B3;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="74" y="1306" width="1612" height="34" as="geometry" />
        </mxCell>
        <mxCell id="cd" value="D. 가드 · 예외 · 계기판" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1410" width="1660" height="128" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;예산 가드&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;스텝 8 · 재검색 hop 3 · LLM 6회 · 20,000 토큰&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a5a00&quot; style=&quot;font-size:10px&quot;&gt;◇ AutoGen 2023 · GraphRAG-R1 2026&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="74" y="1456" width="300" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;fault_response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;어떤 예외에도 200 + 5키 · stage=api&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="394" y="1456" width="288" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;안전성 축&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PII 유출 · 정책적 거절 · 인식론적 거절을 갈라 센다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="702" y="1456" width="288" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;think_trace 계기판&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hop · verdict · verify · regen · citation · budget&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1456" width="288" height="66" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="&lt;b&gt;arm 스위치&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ablation — 분기점을 한 곳의 플래그로 모은다&lt;br&gt;&lt;b&gt;운영 기본값 = 제출 구성 = A25+A26&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="1318" y="1456" width="368" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="&lt;b&gt;근거 논문 17편&lt;/b&gt; — 도면 안의 &lt;font color=&quot;#8a5a00&quot;&gt;◇&lt;/font&gt; 가 그 단계의 근거다. 전문은 &lt;i&gt;docs/pipeline/09-ablation.md&lt;/i&gt; 부록 A·B·C&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;채택 13&lt;/b&gt; : GPT-3 2020 · CoT 2022 · ReAct 2023 · Toolformer 2023 · CAMEL 2023 · AutoGen 2023 · G-Retriever 2024 · GraphReader 2024 · HippoRAG 2024 · ToG-2 2025 · SWE-Lancer 2025 · Relink 2026 · GraphRAG-R1 2026&lt;br&gt;&lt;b&gt;측정 후 기각 4&lt;/b&gt; : Self-Consistency 2023(다수결 순증 0 · 손실 3) · HyperGraphRAG 2025(규칙이 이미 잡은 1,829건은 84.2% 가 arity ≥ 3, 남은 238건은 58.4% 가 arity ≤ 2 라 논문 자신의 전제에 걸린다) · Graph of Thoughts 2024 · GraphRAG 2024&lt;br&gt;&lt;b&gt;논문 근거 없이 우리가 고안한 것&lt;/b&gt; : 정정체인 추적 · 결정적 검증 4종 · 재생성 · 인용 부착 · 인용 떼기 · 입출력 안전 계층 · 안전성 축 · 메타 프리필터&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFFBE6;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="50" y="1556" width="1660" height="104" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;v3 도면 대비 바뀐 것&lt;/b&gt; : ① 기본값 &lt;b&gt;A20r → A25+A26&lt;/b&gt; ② 한계 고지 &lt;b&gt;두 갈래 → 세 갈래&lt;/b&gt;(지시대상 불명) ③ 처분 &lt;b&gt;셋 → 다섯&lt;/b&gt;(인용 부착 · 인용 떼기) ④ &lt;b&gt;근거 기억&lt;/b&gt; 단계 신설 ⑤ 검증 3종 → &lt;b&gt;4종&lt;/b&gt; ⑥ 안전 계층·API 계약의 감사 수정 반영 ⑦ 미측정 후보(치환+재생성 결합)와 미해결(F-8)을 도면에 적었다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="1672" width="1660" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
