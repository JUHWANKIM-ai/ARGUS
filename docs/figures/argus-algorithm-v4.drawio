        <mxCell id="t1" value="ARGUS 공시 Agent — 온라인 파이프라인 &lt;b&gt;v4&lt;/b&gt; · 운영 기본값 &lt;b&gt;A25+A26&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fontSize=20;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="18" width="1180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="HyperCLOVA X (HCX-005) · 질문 하나당 LLM 호출 상한 6회 · 검색과 검증은 LLM 0회&lt;br&gt;&lt;b&gt;그리드 66/72 (±1) · 전체 82/88 · 인용률 0.975&lt;/b&gt; &amp;nbsp;·&amp;nbsp; 정본 &lt;i&gt;artifacts/ablation/v4/repro_0816/&lt;/i&gt; (2026-08-16 · 같은 날 같은 캐시)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fontSize=11;fillColor=none;strokeColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="50" width="1240" height="34" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;font style=&quot;font-size:10px&quot;&gt;정본은 코드다 — &lt;i&gt;src/argus/ablation.py&lt;/i&gt; · &lt;i&gt;agent/pipeline.py&lt;/i&gt; · &lt;i&gt;agent/router.py&lt;/i&gt; · &lt;i&gt;agent/safety.py&lt;/i&gt;. 도면이 코드와 어긋나면 코드가 맞다.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="84" width="1240" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg" value="&lt;b&gt;범례&lt;/b&gt; — 색 = LLM 호출 여부" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1">
