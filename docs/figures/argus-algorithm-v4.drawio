        <mxCell id="lg3" value="&lt;b&gt;검증 · 안전&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;결정적 검사 · PII · 예외 방어&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="1328" y="104" width="180" height="40" as="geometry" />
