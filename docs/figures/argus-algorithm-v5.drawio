<mxfile host="app.diagrams.net" type="device">
  <diagram name="ARGUS v5" id="argus-v5">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1754" pageHeight="1754" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="ARGUS 공시 Agent — 온라인 파이프라인 &lt;b&gt;v5&lt;/b&gt; · 운영 기본값 &lt;b&gt;A38&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=20;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="18" width="1200" height="30" as="geometry" /></mxCell>
        <mxCell id="t2" value="HyperCLOVA X (HCX-005) · 검색·검증·집계·인용은 &lt;b&gt;전부 LLM 0회&lt;/b&gt;&lt;br&gt;&lt;b&gt;그리드 72/72 · 전체 88/88 · 밸류체인 10/12 · 안전성 12/12 · 인용률 0.988&lt;/b&gt; &amp;nbsp;·&amp;nbsp; 합계 &lt;b&gt;110/112&lt;/b&gt; &amp;nbsp;·&amp;nbsp; 정본 &lt;i&gt;artifacts/ablation/v5/a38_*&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="50" width="1240" height="40" as="geometry" /></mxCell>
        <mxCell id="t3" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;정본은 코드다 — &lt;i&gt;src/argus/ablation.py&lt;/i&gt; · &lt;i&gt;agent/pipeline.py&lt;/i&gt; · &lt;i&gt;agent/aggregate.py&lt;/i&gt; · &lt;i&gt;agent/reasoning.py&lt;/i&gt;. 도면이 코드와 어긋나면 코드가 맞다.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="1240" height="18" as="geometry" /></mxCell>
        <mxCell id="lg" value="범례 — 색 = LLM 호출 여부" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1310" y="18" width="400" height="200" as="geometry" /></mxCell>
        <mxCell id="lg1" value="&lt;b&gt;LLM 0회&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;규칙 · 색인 · 집계 · 검증&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1328" y="56" width="180" height="38" as="geometry" /></mxCell>
        <mxCell id="lg2" value="&lt;b&gt;LLM 호출&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;HCX-005 · 크레딧&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1518" y="56" width="174" height="38" as="geometry" /></mxCell>
        <mxCell id="lg3" value="&lt;b&gt;검증 · 안전&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;결정적 검사 · PII&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1328" y="102" width="180" height="38" as="geometry" /></mxCell>
        <mxCell id="lg4" value="&lt;b&gt;분기 · 판정&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1518" y="102" width="174" height="38" as="geometry" /></mxCell>
        <mxCell id="lg5" value="&lt;font style=&#x27;font-size:10px&#x27;&gt;굵은 테두리 = &lt;b&gt;v5 에서 새로 생기거나 고친 단계&lt;/b&gt;&lt;br&gt;🔴 &lt;b&gt;여덟 스위치가 전부 LLM 0회다&lt;/b&gt; — v5 는 새 모델도 새 호출도 안 들였다.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1328" y="148" width="366" height="60" as="geometry" /></mxCell>
        <mxCell id="bA" value="A. 입력 · 라우팅 &amp;nbsp;&amp;nbsp; LLM 0회" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="1240" height="268" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;질의 수신&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;GET /answer · question_id · question&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="166" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;입력 안전 계층&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;sanitize_question · PII 마스킹 · 인젝션 탐지&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="222" width="250" height="52" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;라우터&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;route() — 규칙만으로 가른다 · ◇ CoT 2022&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="286" width="250" height="52" as="geometry" /></mxCell>
        <mxCell id="a4" value="&lt;b&gt;답할 수 있는가&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="350" y="286" width="150" height="52" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;한계 고지 — v5 는 다섯 갈래다&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="530" y="158" width="340" height="18" as="geometry" /></mxCell>
        <mxCell id="a6" value="&lt;b&gt;범위 밖&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;70개사 · 2023.01~2026.03 밖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="530" y="180" width="340" height="34" as="geometry" /></mxCell>
        <mxCell id="a7" value="&lt;b&gt;지목한 보고서 부재&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;어느 보고서인지 되묻는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="530" y="220" width="340" height="34" as="geometry" /></mxCell>
        <mxCell id="a8" value="&lt;b&gt;지시대상 불명&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;어느 기업인지 되묻는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="530" y="260" width="340" height="34" as="geometry" /></mxCell>
        <mxCell id="a9" value="&lt;b&gt;미래 추정 (v5 신설 · A31)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;주가·전망·목표주가·매수 의견 — 공시 기재사항이 아니다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="340" height="38" as="geometry" /></mxCell>
        <mxCell id="a10" value="&lt;b&gt;식별번호 전사 (v5 신설 · A32)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;전화·법인등록번호를 그대로 달라는 요구&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="530" y="344" width="340" height="38" as="geometry" /></mxCell>
        <mxCell id="a11" value="🔴 &lt;b&gt;둘 다 두 신호의 곱집합으로만 발화한다.&lt;/b&gt; &lt;i&gt;향후&lt;/i&gt;·&lt;i&gt;전망&lt;/i&gt;·&lt;i&gt;연락처&lt;/i&gt; 는 공시 본문에도 흔해서 한쪽만으로 가르면 정답 문항이 거절이 된다.&lt;br&gt;&lt;br&gt;평가셋 112문항 전수 &lt;b&gt;오탐 0&lt;/b&gt;. 안전성 &lt;b&gt;9/12 → 12/12&lt;/b&gt;.&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;이 갈래는 크레딧 0원으로 끝난다&lt;/b&gt; — LLM 을 한 번도 안 부른다.&lt;br&gt;&lt;br&gt;재감사가 구멍 둘을 더 찾아 닫았다 — &lt;i&gt;목표주가와 매수 의견&lt;/i&gt; · &lt;i&gt;적정 매수 시점&lt;/i&gt; 은 곱집합을 못 채워 빠져나갔다." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="890" y="180" width="390" height="200" as="geometry" /></mxCell>
        <mxCell id="bB" value="B. 검색 · 근거 &amp;nbsp;&amp;nbsp; LLM 0회" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="410" width="1240" height="250" as="geometry" /></mxCell>
        <mxCell id="b1" value="&lt;b&gt;메타 프리필터&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;corp_name · rcept_dt · group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="446" width="240" height="40" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;BM25 hop 사다리&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;narrow → relax → global&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="494" width="240" height="44" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;섹션 인덱스 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;정기공시 목차 경로&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="546" width="240" height="44" as="geometry" /></mxCell>
        <mxCell id="b4" value="&lt;b&gt;계약상대 그래프 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;발주처 2-hop fan-in/out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="598" width="240" height="44" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;정정체인 추적 hop&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;chain_probe + get_history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="330" y="446" width="250" height="48" as="geometry" /></mxCell>
        <mxCell id="b6" value="&lt;b&gt;역방향 체인 (v5 신설 · A33)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;정정본 → 원공시 · 기업별 라운드로빈 배분&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="330" y="502" width="250" height="56" as="geometry" /></mxCell>
        <mxCell id="b7" value="&lt;b&gt;근거 성형&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;shape_evidence · 생성 직전에만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="330" y="566" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="b8" value="&lt;b&gt;정정사유·주요내용 (A30)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;런타임 사본에만 · 색인 불변&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="330" y="618" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="b9" value="🔴 &lt;b&gt;A33 은 링크가 없어서 못 간 게 아니었다.&lt;/b&gt; &lt;code&gt;related&lt;/code&gt; 는 이미 양방향인데 씨앗 조건(&lt;i&gt;대체본만&lt;/i&gt;)이 막고 있었다. 열고 나니 두 번 더 막혔다 — 씨앗 창(2)이 두 번째 기업에 안 닿았고, 상한(6)을 첫 기업이 독식했다. &lt;b&gt;상한을 안 올리고 배분 순서만 라운드로빈으로 바꿨다.&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;A30 은 A17 이 아니다.&lt;/b&gt; A17 은 코퍼스 3,150건 중 1,588건(50.4%)을 다시 쓰는 조작이라 BM25 색인이 갈려 기각됐다. 이쪽은 A18(nary)이 연 &lt;b&gt;런타임 이음매&lt;/b&gt;에만 얹으므로 색인이 한 바이트도 안 바뀐다. 서식도 &lt;i&gt;투자판단관련주요경영사항&lt;/i&gt; 하나로 좁혔다 — 안 좁힌 첫 판이 Q-110 을 잃었다.&lt;br&gt;&lt;br&gt;여기까지 &lt;b&gt;LLM 0회 · 크레딧 0원&lt;/b&gt;이다." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="446" width="680" height="210" as="geometry" /></mxCell>
        <mxCell id="bC" value="B′. 결정적 집계 &amp;nbsp;&amp;nbsp; LLM 0회 &amp;nbsp;&amp;nbsp; 🔴 v5 신설" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="672" width="1240" height="168" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;집계 한 줄 (A29a)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;합 · 차 · 몫을 우리가 계산해 근거 **머리**에 싣는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="70" y="710" width="270" height="56" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;정정 시계열 (A29b)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;체인의 금액을 접수일 순으로 편다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="360" y="710" width="270" height="56" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;계약상대 분포 (A29c)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;🔴 기각 — Δ 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=none;strokeColor=none;strokeColor=#B3B3B3;fillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="650" y="710" width="250" height="56" as="geometry" /></mxCell>
        <mxCell id="c4" value="🔴 &lt;b&gt;칸이 아니라 줄이다.&lt;/b&gt; v4 는 같은 문항들을 &lt;i&gt;근거를 더 주는&lt;/i&gt; 방향으로 세 번 겨냥해 세 번 다 기각했다(A16 칸 확대 · A17 블록 확대 · 열거 depth). 공통 사유가 &lt;i&gt;“칸을 더 달라”&lt;/i&gt; 였다. 여기서 실리는 것은 블록이 아니라 &lt;b&gt;한 줄&lt;/b&gt;이라 그 사유에 안 걸린다.&lt;br&gt;🔴 &lt;b&gt;자리가 값보다 셌다.&lt;/b&gt; Q-023 에 정정 금액 7건의 시계열을 근거 &lt;b&gt;꼬리&lt;/b&gt;에 실었을 때 답은 여전히 &lt;i&gt;“변동 없이 유지”&lt;/i&gt; 였다. &lt;b&gt;같은 줄을 머리로 옮기자 뒤집혔다.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="776" width="1200" height="60" as="geometry" /></mxCell>
        <mxCell id="bD" value="C. 생성 · 검증 · 처분" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=13;fontStyle=1;fillColor=none;strokeColor=#9AA5B1;dashed=1;" vertex="1" parent="1"><mxGeometry x="50" y="852" width="1240" height="470" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;답변 생성 ①&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;HCX-005 · 온도 0.0 · 난이도 상이면 CoT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="70" y="890" width="250" height="52" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;근거 표기가 있는가&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;quick_check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="70" y="954" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;critic ②&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;judge — 인용이 없을 때만&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="70" y="1006" width="250" height="48" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;결정적 검증 4종&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;재계산 · 답변 내부 산술 · 수치 출처 · 완전성&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="1066" width="250" height="76" as="geometry" /></mxCell>
        <mxCell id="d5" value="&lt;b&gt;발주처 면제 (A36)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;발주처는 공시자가 아니다 — missing_corp 오탐&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="70" y="1154" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="d6" value="&lt;b&gt;처분 — v5 는 여덟 갈래다&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="350" y="882" width="320" height="18" as="geometry" /></mxCell>
        <mxCell id="d7" value="&lt;b&gt;① 각주 (v3)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;결함을 적어 둔다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="350" y="904" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="d8" value="&lt;b&gt;② 치환 (A20)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;재계산값으로 바꾼다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="350" y="944" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="d9" value="&lt;b&gt;③ 재생성 1회 (A20r)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;사유를 실어 다시 쓴다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="350" y="984" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="d10" value="&lt;b&gt;④ 인용 부착 (A25)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;§7.5 형식을 우리가 짓는다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="350" y="1024" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="d11" value="&lt;b&gt;⑤ 인용 떼기 (v4)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;거절이 단 표기를 지운다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="350" y="1064" width="320" height="34" as="geometry" /></mxCell>
        <mxCell id="d12" value="&lt;b&gt;⑥ 집계 치환 (v5 · A29s)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;근거의 amount 로 답변의 합계를 바꾼다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="350" y="1104" width="320" height="38" as="geometry" /></mxCell>
        <mxCell id="d13" value="&lt;b&gt;⑦ 괄호 교정 (v5 · A35)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;억·조 환산을 우리가 다시 쓴다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="350" y="1148" width="320" height="38" as="geometry" /></mxCell>
        <mxCell id="d14" value="&lt;b&gt;⑧ 자기정합 (v5 · A38)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;식과 어긋나는 수를 식 결과로 맞춘다&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="350" y="1192" width="320" height="38" as="geometry" /></mxCell>
        <mxCell id="d15" value="🔴 &lt;b&gt;v5 의 단일 발견 — 값을 줘도 모델은 자기 계산을 더 믿는다.&lt;/b&gt;&lt;br&gt;Q-034 에 정확한 817,900,000,000 을 싣고 &lt;i&gt;“다시 계산하지 말라”&lt;/i&gt; 는 지시까지 붙였는데 모델은 817,100,000,000 을 썼다. &lt;b&gt;그래도 헛일이 아니었다&lt;/b&gt; — 그 줄이 모델에게 &lt;b&gt;식을 쓰게 만들어&lt;/b&gt; equation 검사가 발화했고, 그래서 치환이 닿았다. 줄의 값어치는 답이 아니라 &lt;b&gt;고칠 수 있는 형태&lt;/b&gt;였다.&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;그 대가도 적는다.&lt;/b&gt; 집계 치환은 &lt;i&gt;틀린 합계&lt;/i&gt;를 &lt;i&gt;맞는 합계 + 안 맞는 풀이&lt;/i&gt;로 바꾼다. Q-113·Q-115 가 그 자리이고, 정답률 110/112 를 사는 대신 「추론 논리성」 2건을 냈다 &lt;b&gt;(알고 남긴 선택)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;🔴 &lt;b&gt;치환이 우리 각주를 고쳐 쓰고 있었다.&lt;/b&gt; 본문만 바꾸도록 고쳤다 — 각주는 검사기가 무엇을 봤는가의 &lt;b&gt;기록&lt;/b&gt;이고, 뒤에서 갈아 끼우면 창작이 된다.&lt;br&gt;&lt;br&gt;&lt;b&gt;「추론 논리성」 검사 다섯&lt;/b&gt; (수치 자기정합 · 식 불성립 · 근거 밖 수치 · 순서 오류 · 자기부정) — 실패 양식 일곱 중 다섯. 🔴 전제 누락 · 비약은 &lt;b&gt;측정하지 않는다&lt;/b&gt;. LLM 판정기는 안 세웠다 — closed judge 진단에서 갈린 7건 중 &lt;b&gt;여섯이 오탐&lt;/b&gt;이었다." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="700" y="904" width="580" height="330" as="geometry" /></mxCell>
        <mxCell id="d16" value="&lt;b&gt;출력 안전 계층&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;mask_pii — 금액·접수번호는 보존&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="70" y="1210" width="250" height="44" as="geometry" /></mxCell>
        <mxCell id="d17" value="&lt;b&gt;응답 — 5키 JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;question_id · question · retrieved_context · think_trace · answer · 전부 string&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=7;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="70" y="1266" width="600" height="40" as="geometry" /></mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="d5" target="d16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A8899;" edge="1" parent="1" source="d16" target="d17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="z1" value="&lt;b&gt;v5 결산&lt;/b&gt; — A28 이 틀리던 14문항 중 &lt;b&gt;12건&lt;/b&gt;을 잡았다. 합계 98 → &lt;b&gt;110/112&lt;/b&gt; · 회귀 0 · 비용 약 5,900원.&lt;br&gt;🔴 남은 둘(Q-107 · Q-117)은 산술이 아니라 &lt;b&gt;검색&lt;/b&gt;이 막고, 이번 세대의 신호로는 안 풀린다 — 질문의 &lt;i&gt;두코바니&lt;/i&gt; 와 근거의 &lt;i&gt;Dukovany&lt;/i&gt; 를 잇는 것은 별칭 사전이고, 그것은 평가셋 한 문항을 향해 만드는 장치다.&lt;br&gt;🔴 &lt;b&gt;처음 보는 문항 20개로도 쟀다&lt;/b&gt; — 17/20. 산술 축은 10/10 으로 그대로 듣고, 약점은 &lt;b&gt;열거 완전성&lt;/b&gt; 하나로 모인다." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="50" y="1340" width="1240" height="74" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
